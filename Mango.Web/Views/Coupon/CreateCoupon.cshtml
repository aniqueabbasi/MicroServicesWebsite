@model CouponDto

@{
    ViewData["Title"] = "Create Coupon";
}

<form asp-action="CreateCoupon" method="post">

    <div class="container border p-4">

        <div class="row text-center">

            <h1>Create Coupon</h1>

        </div>

        <hr />

        <div class="row">

            <div class="col-2">
            </div>

            <div class="col-8">

                <div class="form-floating py-2">

                    <input asp-for="CouponCode"
                           class="form-control" />

                    <label asp-for="CouponCode"
                           class="ms-2 text-dark fw-bold"></label>

                    <span asp-validation-for="CouponCode"
                          class="text-danger"></span>

                </div>

                <div class="form-floating py-2">

                    <input asp-for="DiscountAmount"
                           class="form-control" />

                    <label asp-for="DiscountAmount"
                           class="ms-2 text-dark fw-bold"></label>

                    <span asp-validation-for="DiscountAmount"
                          class="text-danger"></span>

                </div>

                <div class="form-floating py-2">

                    <input asp-for="MinAmount"
                           class="form-control" />

                    <label asp-for="MinAmount"
                           class="ms-2 text-dark fw-bold"></label>

                    <span asp-validation-for="MinAmount"
                          class="text-danger"></span>

                </div>

                <div class="row pt-4">

                    <div class="col-6">

                        <a asp-action="CouponIndex"
                               class="btn btn-secondary form-control">

                            Back to List

                        </a>

                    </div>

                    <div class="col-6">

                        <button type="submit"
                                class="btn btn-success form-control">

                            Create

                        </button>

                    </div>

                </div>

            </div>

            <div class="col-2">
            </div>

        </div>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}